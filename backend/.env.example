# Local MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whatsonmyplate
DB_USERNAME=whatson
DB_PASSWORD=change-me

# JWT Security Configuration
JWT_SECRET=replace-with-a-long-random-secret-that-is-at-least-256-bits-long-for-hmac-sha256
JWT_EXPIRATION_MS=86400000

# Google Gemini AI Configuration (Spring AI)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary Image Storage Configuration
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173
